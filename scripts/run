#!/bin/sh
# langstats launcher (macOS, Linux, Git Bash on Windows).
# Finds a Python 3.9+ interpreter and runs langstats.py with the given arguments.
# Set LANGSTATS_PYTHON to force a specific interpreter.
# Never fails: hooks must not break the Claude Code session.

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SCRIPT="$DIR/langstats.py"
CHECK='import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)'

if [ -n "$LANGSTATS_PYTHON" ]; then
  exec "$LANGSTATS_PYTHON" "$SCRIPT" "$@"
fi
if command -v python3 >/dev/null 2>&1 && python3 -c "$CHECK" >/dev/null 2>&1; then
  exec python3 "$SCRIPT" "$@"
fi
if command -v python >/dev/null 2>&1 && python -c "$CHECK" >/dev/null 2>&1; then
  exec python "$SCRIPT" "$@"
fi
if command -v py >/dev/null 2>&1 && py -3 -c "$CHECK" >/dev/null 2>&1; then
  exec py -3 "$SCRIPT" "$@"
fi

echo "langstats: Python 3.9+ not found (tried python3, python, py -3). Set LANGSTATS_PYTHON." >&2
exit 0
